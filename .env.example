# GEMINI_API_KEY / AI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY="MY_GEMINI_API_KEY"
AI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL for Grievance Scribe SQLite / PostgreSQL
DATABASE_URL="sqlite:///./grievance_scribe.db"
