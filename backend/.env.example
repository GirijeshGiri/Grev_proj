# Grievance Scribe Backend Environment Configuration

# AI Provider Configuration
# Set AI_API_KEY to your Gemini API key (or leave empty to run with robust deterministic rule-based analysis)
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini

# Database Connection (SQLite by default, can be switched to postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./grievance_scribe.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Allowed Origins (Comma-separated)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
